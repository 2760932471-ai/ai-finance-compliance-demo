# Uses the existing local Codex login. No Dify or API key required for primary AI.
AUDIT_AI=codex
AUDIT_CODEX_PATH=
MODEL_TIMEOUT=600
AUDIT_CACHE=1
# Optional independent TypeSafe Jev evidence support check (off by default).
# Enabling sends cited text to the official TypeSafe service; credentials stay server-side.
AUDIT_JEV=off
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Starting threshold, not calibrated accuracy; test against reviewed cases before changing.
JEV_CONFIDENCE=0.8
# Local Windows OCR is automatic. Server listens on loopback only.
PORT=8765
# Optional Chinese TrueType/TTC font for searchable PDF reports.
# Bundled WenQuanYi is used by default; set this only to override the font.
AUDIT_PDF_FONT=

# Image/scanned PDF transcription from originals. Raw Windows OCR is preserved.
AUDIT_VISUAL_OCR=on
# Independent transcription batches in flight (1 or 2).
AUDIT_VISUAL_WORKERS=2

# Optional decision reviewer. off | jev | startlux. No Dify needed.
# shadow records comparisons only; gate may downgrade a pass to manual review.
AUDIT_DECISION_PROVIDER=off
AUDIT_DECISION_MODE=shadow
DECISION_CONFIDENCE=0.8
# Deploy separately, then set e.g. http://127.0.0.1:8090/v1/systemone
STARTLUX_ENDPOINT=
# Must match the actual service response model name. Pin weights/server revision.
STARTLUX_MODEL=StartLux-Decision-4B
STARTLUX_API_KEY=
# Enable only for a PyTorch vision-capable StartLux server; GGUF/MLX are text-only.
STARTLUX_IMAGES=off
# Optional locally installed CPU service. Set on after installation.
STARTLUX_AUTOSTART=off
# Include pinned weight, server and inference runtime revisions in cache identity.
STARTLUX_REVISION=
DECISION_TIMEOUT=180
# all = every rule; p0 = only explicitly labelled P0 rules (primary audit remains 65).
DECISION_SCOPE=all
